{
  "name": "loja-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:db": "docker compose up -d --wait postgres-test && pnpm --filter @loja/api db:migrate:test && pnpm --filter @loja/api test",
    "test:db:down": "docker compose down postgres-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "typescript": "5.9.3"
  }
}
