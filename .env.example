# Copie para .env e ajuste. Nunca commite o .env.
PORT=3000
# Conexão do dono do banco (migrações)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loja
# Conexão da aplicação (papel loja_app, sem UPDATE/DELETE/TRUNCATE no ledger)
APP_DATABASE_URL=postgres://loja_app:troque-esta-senha@localhost:5432/loja
# Banco de teste (docker compose, porta 5433)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/loja_test
TEST_APP_DATABASE_URL=postgres://loja_app:loja_app@localhost:5433/loja_test
